# Copy to .env (never commit .env) and change every password.

DB_NAME=smsgateway
DB_USERNAME=smsgateway
DB_PASSWORD=change-me

GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-me-too

# Time zone of the dates shown in the dashboard, e.g. Africa/Kinshasa, Africa/Lubumbashi.
GATEWAY_TIME_ZONE=UTC

# Gateway image. Pin a version and change it to upgrade (docker compose pull && docker compose up -d).
GATEWAY_IMAGE=philipperusare/ultra-sms-gateway:0.1.0

# Port published on the host.
GATEWAY_PORT=8080
